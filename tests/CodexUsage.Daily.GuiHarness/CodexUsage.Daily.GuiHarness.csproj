<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CodexTargetFramework)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>../../src/CodexUsage.DailyPanel/app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ProductDirectory Condition="'$(ProductDirectory)' == ''">../../src/CodexUsage.DailyPanel/bin/Release/$(CodexTargetFramework)-windows</ProductDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CodexDaily"><HintPath>$(ProductDirectory)/CodexDaily.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="CodexUsage.DailyCore"><HintPath>$(ProductDirectory)/CodexUsage.DailyCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="CodexUsage.Core"><HintPath>$(ProductDirectory)/CodexUsage.Core.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
