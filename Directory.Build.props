<Project>
  <PropertyGroup>
    <CodexTargetFramework Condition="'$(CodexTargetFramework)' == ''">net10.0</CodexTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == '' and '$(CodexSourceRevision)' != ''">$(CodexSourceRevision)</SourceRevisionId>
    <InformationalVersion Condition="'$(CodexSourceRevision)' != ''">0.2.0+$(CodexSourceRevision)</InformationalVersion>
    <InformationalVersion Condition="'$(CodexSourceRevision)' == ''">0.2.0-local</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
</Project>
